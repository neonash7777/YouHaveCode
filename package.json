    "viewsContainers": {
      "activitybar": [
        {
          "id": "youhavecode",
          "title": "YOUHAVECODE UNICODE",
          "icon": "resources/unicode.svg"
        }
      ]
    },
    "views": {
      "youhavecode": [
        {
          "id": "youhavecode.unicode",
          "name": "YOUHAVECODE UNICODE"
        }
      ]
    },
    "keybindings": [
      {
        "command": "youhavecode.undoQueryComponent",
        "key": "shift+tab",
        "when": "editorTextFocus && youhavecode.queryActive"
      },
      {
        "command": "youhavecode.acceptSelectedSuggestion",
        "key": "tab",
        "when": "editorTextFocus && suggestWidgetVisible && youhavecode.queryActive"
      },
      {
        "command": "youhavecode.acceptSelectedSuggestion",
        "key": "enter",
        "when": "editorTextFocus && suggestWidgetVisible && youhavecode.queryActive"
      },
      {
        "command": "youhavecode.selectPrevSuggestion",
        "key": "up",
        "when": "editorTextFocus && suggestWidgetVisible && youhavecode.queryActive"
      },
      {
        "command": "youhavecode.selectNextSuggestion",
        "key": "down",
        "when": "editorTextFocus && suggestWidgetVisible && youhavecode.queryActive"
      },
      {
        "command": "youhavecode.deleteLeftAndSuggest",
        "key": "backspace",
        "when": "editorTextFocus && youhavecode.queryActive"
      },
      {
        "command": "youhavecode.deleteRightAndSuggest",
        "key": "delete",
        "when": "editorTextFocus && youhavecode.queryActive"
      },
      {
        "command": "youhavecode.chooseInsertionFormat",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "youhavecode.refreshSidebar",
          "when": "view == youhavecode.unicode",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "youhavecode.clearRecentGlyphs",
          "when": "view == youhavecode.unicode && viewItem == youhavecode.group.recent",
          "group": "inline"
        },
        {
          "command": "youhavecode.clearFrequentGlyphs",
          "when": "view == youhavecode.unicode && viewItem == youhavecode.group.frequent",
          "group": "inline"
        },
        {
          "command": "youhavecode.toggleEditorLineWrapping",
          "when": "view == youhavecode.unicode && viewItem == youhavecode.editorLineWrapping",
          "group": "inline"
        },
        {
          "command": "youhavecode.quickSidebarPrettyPrint",
          "when": "view == youhavecode.unicode && viewItem == youhavecode.prettyPrintOutputChoice",
          "group": "inline"
        },
        {
          "command": "youhavecode.customArtSelection",
          "when": "view == youhavecode.unicode && viewItem == youhavecode.prettyPrintCustomChoice",
          "group": "inline"
        },
        {
          "command": "youhavecode.movePrettyPrintFontFamilyTop",
          "when": "view == youhavecode.unicode && viewItem == youhavecode.prettyPrintFontFamily",
          "group": "font-order@1"
        },
        {
          "command": "youhavecode.movePrettyPrintFontFamilyUp",
          "when": "view == youhavecode.unicode && viewItem == youhavecode.prettyPrintFontFamily",
          "group": "font-order@2"
        },
        {
          "command": "youhavecode.movePrettyPrintFontFamilyDown",
